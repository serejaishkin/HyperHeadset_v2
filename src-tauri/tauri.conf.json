{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "HyperX NGENUITY Open",
  "version": "0.2.10",
  "identifier": "com.hyperx-ngenuity-open.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HyperX NGENUITY Open",
        "width": 980,
        "height": 600,
        "minWidth": 400,
        "minHeight": 300,
        "center": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}