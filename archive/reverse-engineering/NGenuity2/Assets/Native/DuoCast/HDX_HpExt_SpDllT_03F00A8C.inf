HKLM,SYSTEM\CurrentControlSet\Services\IntelAudioService\Config,"ppDllConfigurationFile",,%13%\gen4pkey_03F00A8C.dat
HKLM,SYSTEM\CurrentControlSet\Services\IntelAudioService\Parameters,"ppDllName",0x00020000,%13%\RTKSpeechPP2_2.dll
HKLM,SYSTEM\CurrentControlSet\Services\IntelAudioService\Parameters,"ppDllConfigurationFile",,%13%\gen4pkey_03F00A8C.dat

[Int2ndConfig.AddReg.Security]
"G:BUD:(A;CIOI;KA;;;BU)"

[Strings]
