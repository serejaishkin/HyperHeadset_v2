[Version]
Signature   = "$Windows NT$"
Class       = Extension
ClassGuid   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider    = Realtek
ExtensionId = {7f7901fa-ea73-4a95-bada-55bf89f37009}
DriverVer = 07/12/2022, 6.0.0.18
CatalogFile = HDXRTAPOExt.cat
PnpLockDown = 1

[SourceDisksNames]
222 = %DiskId1%

[SourceDisksFiles]
RTKSpeechPP2_2.dll=222
gen4pkey_03F00A8C.dat=222

[DestinationDirs]
DefaultDestDir=13

[SignatureAttributes]
RTKSpeechPP2_2.dll=SignatureAttributes.PETrust

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
"Intel(R) Corporation" = Intel, NTAMD64.10.0...16273

[Intel.NTAMD64.10.0...16273]
%Device.ExtensionDesc% = DeviceExtension_Install, USB\VID_03F0&PID_0A8C&MI_00

[DeviceExtension_Install]
CopyFiles = Gen4pKey.CopyList
AddReg = Int2ndConfig.AddReg

[Gen4pKey.CopyList]
RTKSpeechPP2_2.dll
gen4pkey_03F00A8C.dat

[Int2ndConfig.AddReg]
