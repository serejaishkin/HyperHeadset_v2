;;***************Cloud II Wireless ********************************
[HyperX03F0018B]
CopyFiles = HyperX03F0018B.CopyList

[HyperX03F0018B.Components]
AddComponent = DTSAPO,,DTSAPO_Install
AddComponent = DTSService,,DTSService_Install

[HyperX03F0018B.Interfaces]
;; ***The topology interface name "global" is a default name.
;; ***This should be modified and synchronized with audio codec vender.
AddInterface=%KSCATEGORY_AUDIO%,"global",HyperX03F0018B.IntReg
AddInterface=%KSCATEGORY_TOPOLOGY%,"global",HyperX03F0018B.IntReg

[HyperX03F0018B.IntReg]
AddReg = DTS.SpkIntPresetAddReg, DTSAPO4.SpkAddReg
AddReg = HyperX03F0018B.IntPresetAddReg

[HyperX03F0018B.IntPresetAddReg]
HKR,"EP\\0",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_SPEAKER%
HKR,EP\0,"{7A8B74C8-FA66-4460-8542-D6119C59E9D4},4", %REG_DWORD%, 0x0 ;;
HKR,EP\0,%PKEY_DTS_CONFIG_FILE%,%REG_SZ%,"%%SystemRoot%%\system32\DTS\HP\APO4x\HyperX\dts_apo4_hpxv2_oem_config_03F0018B.xml"


