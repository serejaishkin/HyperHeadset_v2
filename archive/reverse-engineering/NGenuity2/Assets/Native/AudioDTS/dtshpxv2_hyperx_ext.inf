;;If you are using Windows inbox driver, then you can use this AddReg section for reference.
[DTSAPO4.AddReg]
HKR,FX\0,%PKEY_ItemNameDisplay%,,%FriendlyName_Headset%
HKR,FX\0,%PKEY_FX_Association%,,%KSNODETYPE_HEADPHONES%
HKR,FX\0,%PKEY_CompositeFX_StreamEffectClsid%,%REG_MULTI_SZ%,%DTS_SFX_CLSID%
HKR,FX\0,%PKEY_SFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%,%AUDIO_SIGNALPROCESSINGMODE_NOTIFICATION%,%AUDIO_SIGNALPROCESSINGMODE_RAW%

[DTS.IntPresetAddReg]
;; 21H2 CAPX
HKR,"FX\\0",%PKEY_FX_Association%,,%KSNODETYPE_HEADPHONES%
HKR,"FX\\0\\%DTSAPO4XSFX_PS_CONTEXT%",%PKEY_FX_Association%,,%KSNODETYPE_HEADPHONES%

HKR,FX\0\%DTSAPO4XSFX_PS_CONTEXT%\User,%PKEY_DTS_APO4X_KEY%,REG_DWORD,0x0
HKR,FX\0\%DTSAPO4XSFX_PS_CONTEXT%\Default, %PKEY_DTS_APO4X_KEY%,REG_DWORD,0x1
HKR,FX\0\%DTSAPO4XSFX_PS_CONTEXT%\Volatile,%PKEY_DTS_APO4X_KEY%,REG_DWORD,0x0

HKR,"FX\\0\\%DTSAPO4XMFX_PS_CONTEXT%",%PKEY_FX_Association%,,%KSNODETYPE_HEADPHONES%
HKR,FX\0\%DTSAPO4XMFX_PS_CONTEXT%\User,%PKEY_DTS_APO4X_KEY%,REG_DWORD,0x0
HKR,FX\0\%DTSAPO4XMFX_PS_CONTEXT%\Default, %PKEY_DTS_APO4X_KEY%,REG_DWORD,0x1
HKR,FX\0\%DTSAPO4XMFX_PS_CONTEXT%\Volatile, %PKEY_DTS_APO4X_KEY%,REG_DWORD,0x1

HKR,"FX\\0\\%DTSAPO4XEFX_PS_CONTEXT%",%PKEY_FX_Association%,,%KSNODETYPE_HEADPHONES%
HKR,FX\0\%DTSAPO4XEFX_PS_CONTEXT%\User,%PKEY_DTS_APO4X_KEY%,REG_DWORD,0x0
HKR,FX\0\%DTSAPO4XEFX_PS_CONTEXT%\Default, %PKEY_DTS_APO4X_KEY%,REG_DWORD,0x1
HKR,FX\0\%DTSAPO4XEFX_PS_CONTEXT%\Volatile, %PKEY_DTS_APO4X_KEY%,REG_DWORD,0x1

HKR,"FX\\0\\%DTSAPO4XGLOBAL_PS_CONTEXT%",%PKEY_FX_Association%,,%KSNODETYPE_HEADPHONES%
HKR,FX\0\%DTSAPO4XGLOBAL_PS_CONTEXT%\User,%PKEY_DTS_APO4X_KEY%,REG_DWORD,0x0
HKR,FX\0\%DTSAPO4XGLOBAL_PS_CONTEXT%\Default, %PKEY_DTS_APO4X_KEY%,REG_DWORD,0x1
