[Version]
Signature   = "$Chicago$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
CatalogFile = kinsapo_7p1_spk_uac.cat
DriverVer = 05/19/2020,3.7.9.0
pnplockdown = 0

[ControlFlags]
ExcludeFromSelect = *

[SourceDisksNames]
222 = %DiskDescription%,,,

[SourceDisksFiles]
kinsapo_7p1_spk_uac.sys = 222

;;
;; PE Signature
;;
[SignatureAttributes]
kinsapo_7p1_spk_uac.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%MfgName% = StingerUSBDriver, NTamd64.10.0

[StingerUSBDriver.NTamd64.10.0]
%StingerUSB.DeviceDesc% = StingerUSB.NTamd64.10.0, USB\VID_0951&PID_1715&REV_4102&MI_00

[DestinationDirs]
StingerUSB.CopyFiles      = 12

;;Windows 10 Device Guard Requirement
[StingerUSB.CopyFiles]
kinsapo_7p1_spk_uac.sys

;======================================================
; StingerUSB.NTamd64.10.0
;======================================================
[StingerUSB.NTamd64.10.0]
Include   = ks.inf,wdmaudio.inf
Needs     = KS.Registration,WDMAUDIO.Registration,mssysfx.CopyFilesAndRegister
CopyFiles = StingerUSB.CopyFiles
AddReg    = StingerUSB.AddReg, AudioParameters.AddReg
 
[StingerUSB.NTamd64.10.0.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_Wave%,     StingerUSB.I.Wave
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_Wave%,     StingerUSB.I.Wave
AddInterface = %KSCATEGORY_CAPTURE%, %KSNAME_Wave%,     StingerUSB.I.Wave
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_Topology%, StingerUSB.I.Topo

[StingerUSB.NTamd64.10.0.Services]
AddService = usbaud, 0x00000002, UsbAudio64_Service_Inst_W10

[StingerUSB.NTamd64.10.0.HW]
AddReg = StingerUSB.HW.AddReg

;;==================================
;; Add Service for Driver
;;==================================
[UsbAudio64_Service_Inst_W10]
DisplayName   = %StingerUSB.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\kinsapo_7p1_spk_uac.sys

;;===================================
;; FriendlyName Modification
;;===================================
[StingerUSB.HW.AddReg]
HKR,,FriendlyName,,%StingerUSB.HW.Name%

;======================================================
; COMMON
;======================================================
[StingerUSB.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%StingerUSB.DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%StingerUSB.MidiDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%StingerUSB.DeviceDesc%
HKR,,Driver,,kinsapo_7p1_spk_uac.sys
HKR,,NTMPDriver,,"kinsapo_7p1_spk_uac.sys,sbemul.sys"


[StingerUSB.I.Wave]
AddReg=StingerUSB.I.Wave.AddReg

[StingerUSB.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%StingerUSB.Wave.szPname%
 
[StingerUSB.I.Topo]
AddReg = StingerUSB.I.Topo.AddReg, ESysFx.Main.AddReg, USBAudio.EPProperties.AddReg

[StingerUSB.I.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%StingerUSB.Topo.szPname%

     
;; Note: MSEP\\n is reserved for Microsoft inbox inf use ONLY. 
;; To avoid undeterminitic result, 3rd party driver INF should use EP\\n instead.	 
[ESysFx.Main.AddReg]
HKR,"EP\\0",%PKEY_Endpoint_ID%,%REG_DWORD%,0x0100
HKR,"EP\\0",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_SPEAKER%
HKR,"EP\\0",%PKEY_AudioEndpoint_PhysicalSpeakers%,%REG_DWORD%,0x0000063F
HKR,"EP\\0",%PKEY_AudioEndpoint_FullRangeSpeakers%,%REG_DWORD%,0x0000063F
HKR,"EP\\0",%PKEY_AudioEngine_OEMFormat%, 1,41,00,8C,70,28,00,00,00,FE,FF,08,00,80,bb,00,00,00,B8,0B,00,10,00,10,00,16,00,10,00,3f,06,00,00,01,00,00,00,00,00,10,00,80,00,00,AA,00,38,9B,71

[USBAudio.EPProperties.AddReg]
;; Note: MSEP\\n is reserved for Microsoft inbox inf use ONLY.
;; To avoid undeterminitic result, 3rd party driver INF should use EP\\n instead.
HKR,"EP\\0",%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,"EP\\0",%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1 ;;enable WaveRT Pull mode

;======================================================
; Audio settings                                   
;======================================================
[AudioParameters.AddReg]
HKR,,EnableWaveRT,                          1,01,00,00,00
HKR,GlobalSettings,SelectiveSuspend,        1,00,00,00,00  ;; Support Selective Suspend
HKR,GlobalSettings,OverrideDeviceVersion,   1,09,00,00,00  ;;
HKR,GlobalSettings,Customized3D,            1,0D,00,00,00  ;; Enable Custized3D, Enabled 8ch

HKR,GlobalSettings,DisableJackSense,        1,01,00,00,00  ;; NO Jack Sense
HKR,GlobalSettings, InterfaceID,            1,00,00,00,00  ; For audio device is in MI_00

[Strings]
ProviderName        = "Kingston Technology Corporation"
MfgName             = "Kingston Technology Corporation"
ProductName         = "StingerUSB"
DiskDescription     = "StingerUSB"
UIPATH              = "StingerUSB"
UninstallName       = "StingerUSB"

StingerUSB.DeviceDesc     = "Stinger USB"
StingerUSB.SvcDesc        = "Stinger USB"
StingerUSB.MidiDesc       = "Stinger USB"
StingerUSB.HW.Name        = "Stinger USB"
StingerUSB.Wave.szPname   = "Stinger USB Wave"
StingerUSB.Topo.szPname   = "Stinger USB Topology"

