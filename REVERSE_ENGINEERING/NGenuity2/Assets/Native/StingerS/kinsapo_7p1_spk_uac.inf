;;FxProperties Value
SYSFX_NULL_FriendlyName = "No Audio Effects"
SYSFX_NULL_CLSID = "{00000000-0000-0000-0000-000000000000}"
SYSFX_NULL_UI_CLSID = "{00000000-0000-0000-0000-000000000000}"

;;Topology
Proxy.CLSID         = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO    = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER   = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
